{
    "required_api_version": "^2.0.0",
    "name": "ChatGPT",
    "description": "Domain-specific assistant на OpenAI Responses API",
    "developer_name": "SeoFernando",
    "icon": "images/icon.png",
    "options": {
        "query_debounce": 1
    },
    "preferences": [
        {
            "id": "gpt_kw",
            "type": "keyword",
            "name": "GPT",
            "default_value": "gpt"
        },
        {
            "id": "api_key",
            "type": "input",
            "name": "OpenAI API Key",
            "description": "Ключ OpenAI API",
            "default_value": ""
        },
        {
            "id": "model",
            "type": "select",
            "name": "OpenAI model",
            "description": "Консервативный whitelist + custom",
            "default_value": "gpt-5",
            "options": [
                {"value": "gpt-5", "text": "gpt-5"},
                {"value": "gpt-5-mini", "text": "gpt-5-mini"},
                {"value": "gpt-5-nano", "text": "gpt-5-nano"},
                {"value": "custom", "text": "Custom model"}
            ]
        },
        {
            "id": "custom_model",
            "type": "input",
            "name": "Custom Model Name",
            "description": "Используется только при model=custom",
            "default_value": ""
        },
        {
            "id": "system_prompt",
            "type": "input",
            "name": "System Prompt",
            "description": "Контекст и правила ответа",
            "default_value": "Ты полезный ассистент, отвечай коротко."
        },
        {
            "id": "reasoning_effort",
            "type": "select",
            "name": "Reasoning Effort",
            "description": "Насколько глубоко модель рассуждает",
            "default_value": "minimal",
            "options": [
                {"value": "minimal", "text": "minimal"},
                {"value": "low", "text": "low"},
                {"value": "medium", "text": "medium"},
                {"value": "high", "text": "high"}
            ]
        },
        {
            "id": "verbosity",
            "type": "select",
            "name": "Verbosity",
            "description": "Детализация ответа",
            "default_value": "low",
            "options": [
                {"value": "low", "text": "low"},
                {"value": "medium", "text": "medium"},
                {"value": "high", "text": "high"}
            ]
        },
        {
            "id": "endpoint_url",
            "type": "input",
            "name": "OpenAI endpoint URL",
            "description": "По умолчанию: https://api.openai.com/v1/responses",
            "default_value": "https://api.openai.com/v1/responses"
        },
        {
            "id": "temperature",
            "type": "input",
            "name": "Temperature",
            "description": "Диапазон 0..2",
            "default_value": "1"
        },
        {
            "id": "max_completion_tokens",
            "type": "input",
            "name": "Max Output Tokens",
            "description": "Legacy id сохранен для обратной совместимости",
            "default_value": "500"
        },
        {
            "id": "top_p",
            "type": "input",
            "name": "Top P",
            "description": "Диапазон 0..1",
            "default_value": "1.0"
        },
        {
            "id": "frequency_penalty",
            "type": "input",
            "name": "Frequency Penalty",
            "description": "Диапазон -2..2",
            "default_value": "0.0"
        },
        {
            "id": "presence_penalty",
            "type": "input",
            "name": "Presence Penalty",
            "description": "Диапазон -2..2",
            "default_value": "0.0"
        },
        {
            "id": "line_wrap",
            "type": "input",
            "name": "Line Length",
            "description": "Максимум символов в строке интерфейса",
            "default_value": "50"
        },
        {
            "id": "debug_mode",
            "type": "select",
            "name": "Debug Mode",
            "description": "Логирование безопасной диагностики (без секретов)",
            "default_value": "false",
            "options": [
                {"value": "false", "text": "Off"},
                {"value": "true", "text": "On"}
            ]
        },
        {
            "id": "locale",
            "type": "select",
            "name": "Locale",
            "description": "Язык UI-строк плагина",
            "default_value": "ru",
            "options": [
                {"value": "ru", "text": "Русский"},
                {"value": "en", "text": "English"}
            ]
        }
    ]
}
